{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emg.local/schemas/projector-identities.schema.json",
  "title": "EMG Audit Projector Identity Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "projector_identities"],
  "properties": {
    "version": {"const": 1},
    "projector_identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tenant_id", "client_id"],
        "properties": {
          "tenant_id": {"type": "string", "minLength": 1},
          "client_id": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
