{
  "realm": "emg",
  "enabled": true,
  "displayName": "EMG Core Platform (Local Development)",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "platform-user",
        "description": "Baseline authenticated EMG platform user. Catalogued in the RBAC baseline role catalog (Sprint 5, FEAT-03-3: emg_policy_engine.roles.ROLE_CATALOG)."
      },
      {
        "name": "investigator",
        "description": "Case investigator \u2014 Investigation Agent scope (Module 9 \u00a75), local dev seed only. Catalogued in emg_policy_engine.roles.ROLE_CATALOG (FEAT-03-3)."
      },
      {
        "name": "decision-maker",
        "description": "Accountable decision-maker \u2014 Human Decision Workspace, local dev seed only. Catalogued in emg_policy_engine.roles.ROLE_CATALOG (FEAT-03-3)."
      },
      {
        "name": "knowledge-steward",
        "description": "Knowledge Graph steward \u2014 Knowledge Authoring UI, local dev seed only. Catalogued in emg_policy_engine.roles.ROLE_CATALOG (FEAT-03-3)."
      },
      {
        "name": "service-account",
        "description": "Service account role for internal EMG service authentication and controlled machine-to-machine access."
      },
      {
        "name": "svc-identity",
        "description": "Sprint 3 (FEAT-02-3): least-privilege role for the Identity Service's own service principal. Catalogued in emg_policy_engine.roles.ROLE_CATALOG (FEAT-03-3)."
      },
      {
        "name": "svc-authorization",
        "description": "Authorization service role for managing policy evaluation and access control decisions across EMG services."
      },
      {
        "name": "svc-audit",
        "description": "Sprint 3 (FEAT-02-3): least-privilege role for the (not-yet-implemented, EPIC-04) Audit Service's service principal \u2014 registered now for the same reason. Catalogued in emg_policy_engine.roles.ROLE_CATALOG (FEAT-03-3)."
      },
      {
        "name": "svc-knowledge-graph-writer",
        "description": "ADR-027 (Rev 2) Stage 0: least-privilege role for a service principal authorized to mutate the Knowledge Graph. Catalogued in emg_policy_engine.roles.ROLE_CATALOG."
      }
    ]
  },
  "clientScopes": [
    {
      "name": "emg-internal-services-audience",
      "description": "Sprint 3 (FEAT-02-3): adds the shared 'emg-internal-services' audience to a client-credentials access token, so services/identity's ServiceTokenValidator can enforce audience validation for machine-to-machine calls without per-caller configuration.",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "emg-internal-services-audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "emg-internal-services",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "emg-human-classification-attributes",
      "description": "Group D Phase 1 Remediation (2026-07-27): projects classification_clearance and department user attributes into the access token as top-level claims for services/identity's login flow. See docs/security for full rationale.",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "emg-classification-clearance-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "classification_clearance",
            "claim.name": "classification_clearance",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "emg-department-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "department",
            "claim.name": "department",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "emg-human-tenant-claim",
      "description": "Phase 2B (ADR-035 D-5 / ADR-038 8.5): projects tenant_id into the access token for human principals, mirroring the service tenant mapper. Attached to emg-identity-service and emg-studio-bff. See docs/security for full rationale.",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "emg-human-tenant-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "multivalued": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "emg-human-delegated-claims",
      "description": "Phase 2B (ADR-038 Ch. VII): attached to emg-knowledge-graph-audience. Restores sub/tenant_id/classification_clearance/roles on the exchanged Delegated Credential. See docs/security/adr-038/02_KEYCLOAK_VERIFICATION_CONFIG.md.",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "emg-delegated-subject-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "id",
            "claim.name": "sub",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "emg-delegated-tenant-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "multivalued": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "emg-delegated-clearance-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "classification_clearance",
            "claim.name": "classification_clearance",
            "jsonType.label": "String",
            "multivalued": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "emg-delegated-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "emg-service-security-claims",
      "description": "SRS-2: emits verified tenant, classification-clearance, and realm-role claims consistently for every approved service client.",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "emg-service-tenant-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "multivalued": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "emg-service-clearance-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "classification_clearance",
            "claim.name": "classification_clearance",
            "jsonType.label": "String",
            "multivalued": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "emg-service-realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "emg-human-identity-claims",
      "description": "Finding 3: restores sub and realm_access.roles on the human access token. emg-studio-bff's scopes fully replace Keycloak's built-ins, so neither claim appears without this -- confirmed via a real Authorization Code flow.",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "emg-human-subject-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "id",
            "claim.name": "sub",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "emg-human-realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "emg-identity-service",
      "name": "EMG Identity Service",
      "description": "Confidential client used by services/identity to exchange user credentials for tokens (FEAT-02-1). Not exposed to browsers.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "emg_identity_local_dev_secret_do_not_use_in_prod",
      "redirectUris": [],
      "webOrigins": [],
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "emg-human-classification-attributes",
        "emg-human-tenant-claim"
      ],
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "emg-studio-bff",
      "name": "EMG Studio BFF",
      "description": "ADR-035 D-3 / ADR-036: confidential client owned by the Studio BFF. Terminates Authorization Code + PKCE S256 for human sessions; secret never reaches the browser. Also the Acting Service (ADR-038) performing RFC 8693 token exchange.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "emg_studio_bff_local_dev_secret_do_not_use_in_prod",
      "redirectUris": [
        "http://localhost:8010/auth/callback"
      ],
      "webOrigins": [],
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "emg-human-classification-attributes",
        "emg-human-tenant-claim",
        "emg-human-identity-claims"
      ],
      "attributes": {
        "access.token.lifespan": "300",
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "emg-knowledge-graph-audience",
      "name": "EMG Knowledge Graph Delegated-Credential Audience",
      "description": "ADR-038 Ch. IV Trust Domain D: bearer-only client representing Knowledge Graph as one isolated downstream audience for token exchange. A second Platform Service needs its own audience client, never this one reused.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "emg-human-delegated-claims"
      ],
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "emg-svc-identity",
      "name": "EMG Service Principal \u2014 Identity Service",
      "description": "Sprint 3 FEAT-02-3: Identity service account client for M2M OAuth2 authentication.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "emg_svc_identity_local_dev_secret_do_not_use_in_prod",
      "redirectUris": [],
      "webOrigins": [],
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "emg-internal-services-audience",
        "emg-service-security-claims"
      ],
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "emg-svc-authorization",
      "name": "EMG Service Principal \u2014 Authorization Service",
      "description": "Enterprise identity and access management configuration for EMG platform users, roles, and security policies.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "emg_svc_authorization_local_dev_secret_do_not_use_in_prod",
      "redirectUris": [],
      "webOrigins": [],
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "emg-internal-services-audience",
        "emg-service-security-claims"
      ],
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "emg-svc-audit",
      "name": "EMG Service Principal \u2014 Audit Service",
      "description": "Sprint 3 (FEAT-02-3): representative development service identity for the future Audit Service (Module 6, EPIC-04). Registered now so service-to-service auth exists from day one; no Audit Service business logic is implemented in this sprint.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "emg_svc_audit_local_dev_secret_do_not_use_in_prod",
      "redirectUris": [],
      "webOrigins": [],
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "emg-internal-services-audience",
        "emg-service-security-claims"
      ],
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "emg-svc-knowledge-graph-writer",
      "name": "EMG Service Principal \u2014 Knowledge Graph Writer",
      "description": "SRS-2: approved least-privilege client for ADR-027 mutations.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "emg_svc_knowledge_graph_writer_local_dev_secret_do_not_use_in_prod",
      "redirectUris": [],
      "webOrigins": [],
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "emg-internal-services-audience",
        "emg-service-security-claims"
      ],
      "attributes": {
        "access.token.lifespan": "300"
      }
    }
  ],
