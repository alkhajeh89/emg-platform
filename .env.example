# EMG Platform — local development environment template
# ======================================================
# Copy to `.env` at the repo root:   cp .env.example .env
#
# `.env` is git-ignored (.gitignore keeps `.env` and `.env.*` out of source
# control; only this `.env.example` is tracked). The service settings objects
# (services/identity, services/audit — pydantic-settings) read this file at the
# repo root via `env_file=".env"`.
#
# EVERY VALUE BELOW IS A NON-SECRET LOCAL-DEVELOPMENT PLACEHOLDER. It matches the
# literals already baked into docker-compose.yml for the local stack. Real
# deployments override these from the centralized secrets store (Engineering
# Master Plan §5) — never commit real secrets to this or any tracked file.
#
# These have safe in-code defaults; you only need `.env` if you want to point a
# locally-run (non-Docker) service at different values, or to run the audit
# service against the Dockerized Postgres.

# --- Identity service (EMG_IDENTITY_*) --------------------------------------
EMG_IDENTITY_KEYCLOAK_BASE_URL=http://localhost:8080
EMG_IDENTITY_KEYCLOAK_REALM=emg
EMG_IDENTITY_KEYCLOAK_CLIENT_ID=emg-identity-service
EMG_IDENTITY_KEYCLOAK_CLIENT_SECRET=emg_identity_local_dev_secret_do_not_use_in_prod
# Symmetric (HS256) session signing key — LOCAL DEV ONLY.
EMG_IDENTITY_SESSION_SIGNING_KEY=emg_local_dev_session_signing_key_do_not_use_in_prod
# This service's own outbound machine (M2M) credentials — LOCAL DEV ONLY.
EMG_IDENTITY_SERVICE_CLIENT_ID=emg-svc-identity
EMG_IDENTITY_SERVICE_CLIENT_SECRET=emg_svc_identity_local_dev_secret_do_not_use_in_prod

# --- Audit service (EMG_AUDIT_*) --------------------------------------------
# store_backend: "memory" (default; tests / no-DB local) or "postgres".
EMG_AUDIT_STORE_BACKEND=memory
# Used only when EMG_AUDIT_STORE_BACKEND=postgres; matches docker-compose.yml.
EMG_AUDIT_POSTGRES_DSN=postgresql://emg_audit_app:emg_audit_local_dev_only_do_not_use_in_prod@localhost:5432/emg
EMG_AUDIT_KEYCLOAK_BASE_URL=http://localhost:8080
EMG_AUDIT_KEYCLOAK_REALM=emg
